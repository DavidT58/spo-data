# spo-monitor configuration. Copy to .env and fill in the secrets.
# `.env` is gitignored. The systemd unit loads this file via EnvironmentFile.

# --- Required: Telegram delivery (single chat) ---
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
TELEGRAM_CHAT_ID=123456789

# --- Optional: paths ---
# Directory of per-operator YAML config files (default: c)
MONITOR_CONFIG_DIR=c
# SQLite state database path (default: data.db)
MONITOR_DB=data.db

# --- Optional: polling cadence ---
# How often to check block production (Go duration; default: 10m)
MONITOR_BLOCK_INTERVAL=10m
# How often to evaluate KES expiry (default: 12h)
MONITOR_KES_INTERVAL=12h
# Reminder cadence while a block alert persists, in hours (default: 12)
MONITOR_REMINDER_HOURS=12

# --- Optional: daily Telegram quiet hours ---
# Both times use HH:MM. Start is inclusive; end is exclusive.
# Leave both unset to disable quiet hours. Monitoring continues overnight.
# Pending pool alerts are reassessed on the next normal poll outside the window.
MONITOR_QUIET_START=00:00
MONITOR_QUIET_END=08:00
# IANA time zone, including daylight-saving changes (default: Local).
# Set this explicitly if the server uses a different time zone from yours.
MONITOR_QUIET_TIMEZONE=Europe/Belgrade

# --- Optional: adaptive block-production thresholds ---
# Multiplier on a pool's expected inter-block gap before alerting (default: 3)
MONITOR_K=3
# Never alert faster than this many hours of no blocks (default: 24)
MONITOR_FLOOR_HOURS=24
# Always alert by this many hours of no blocks, regardless of stake (default: 336 = 14d)
MONITOR_CAP_HOURS=336
# Pools expected to produce fewer than this many blocks/epoch get NO block alerts
# (retired / ~0-stake pools are statistically un-monitorable). Default: 1.0
MONITOR_MIN_BLOCKS_EPOCH=1.0

# --- Optional: KES alert tiers (days before estimated expiry) ---
MONITOR_KES_THRESHOLDS=14,7,2

# --- Optional: Apex Fusion Prime network constants ---
# Defaults are the VERIFIED on-chain genesis values. Do NOT trust the Blockfrost
# /genesis endpoint, which returns Cardano-mainnet values (62, etc.) on Prime.
# Override only after a Prime hard-fork that changes these.
PRIME_MAX_KES_EVOLUTIONS=60
PRIME_SLOTS_PER_KES_PERIOD=129600
PRIME_SLOT_LENGTH=1
PRIME_EPOCH_LENGTH=432000
PRIME_ACTIVE_SLOTS_COEFF=0.05

# ============ spo-dashboard (cmd/spo-dashboard) ============
# All DASHBOARD_* values below show their defaults; the daemon runs with no env
# at all on fr-0. Shares the PRIME_* constants above.

# HTTP listen address (nginx proxies to this; keep on loopback)
#DASHBOARD_LISTEN=127.0.0.1:8090
# Config dir + own SQLite DB (never spo-monitor's data.db)
#DASHBOARD_CONFIG_DIR=c
#DASHBOARD_DB=dashboard.db

# cardano-cli + node + genesis on this host
#DASHBOARD_CLI=/opt/cardano/bin/cardano-cli
#DASHBOARD_SOCKET=/var/opt/apex/prime-mainnet/david-main-fr-0/node.sock
#DASHBOARD_GENESIS=/etc/apex/prime-mainnet/nodes/configuration/genesis/shelley/genesis.json
# Network flag passed to cardano-cli. Prime's shelley genesis declares
# networkId Mainnet / magic 764824073, so --mainnet is correct (verified).
#DASHBOARD_NETWORK_FLAG=--mainnet

# Directory of <poolID>.vrf.{skey,vkey} files (0700 dir / 0600 files)
#DASHBOARD_KEYS_DIR=/opt/spo-data/keys

# Blockfrost instance the dashboard trusts. Set this EXPLICITLY in production:
# when unset, the fallback is whichever operator config file sorts first, which
# is an arbitrary choice. Shown in /api/health.
DASHBOARD_BLOCKFROST_URL=https://blockfrost.prime.mainnet.apexfusion.org

# --- Cadence + safety margins ---
# NOTE: systemd EnvironmentFile does NOT strip inline comments — keep each
# comment on its own line when uncommenting values below.
# Epoch detection / schedule catch-up tick (Go duration)
#DASHBOARD_EPOCH_POLL=2m
# Produced/missed reconciliation interval
#DASHBOARD_RECONCILE_INTERVAL=15m
# Timeout per leadership-schedule run
#DASHBOARD_CLI_TIMEOUT=15m
# Pause between per-pool cli runs
#DASHBOARD_CLI_GAP=5s
# Concurrent leadership-schedule runs (2-core host: 2; set 1 for sequential)
#DASHBOARD_CLI_PARALLEL=2
# Slots behind tip before settling a slot
#DASHBOARD_SETTLE_MARGIN_SLOTS=600
# Schedule attempts per pool per epoch (Blockfrost errors do not count)
#DASHBOARD_MAX_ATTEMPTS=3
# Pre-launch epochs of actuals to backfill
#DASHBOARD_BACKFILL_EPOCHS=10
