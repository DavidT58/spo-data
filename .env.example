# spo-monitor configuration. Copy to .env and fill in the secrets.
# `.env` is gitignored. The systemd unit loads this file via EnvironmentFile.

# --- Required: Telegram delivery (single chat) ---
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
TELEGRAM_CHAT_ID=123456789

# --- Optional: paths ---
# Directory of per-operator YAML config files (default: c)
MONITOR_CONFIG_DIR=c
# SQLite state database path (default: data.db)
MONITOR_DB=data.db

# --- Optional: polling cadence ---
# How often to check block production (Go duration; default: 10m)
MONITOR_BLOCK_INTERVAL=10m
# How often to evaluate KES expiry (default: 12h)
MONITOR_KES_INTERVAL=12h
# Reminder cadence while a block alert persists, in hours (default: 12)
MONITOR_REMINDER_HOURS=12

# --- Optional: adaptive block-production thresholds ---
# Multiplier on a pool's expected inter-block gap before alerting (default: 3)
MONITOR_K=3
# Never alert faster than this many hours of no blocks (default: 24)
MONITOR_FLOOR_HOURS=24
# Always alert by this many hours of no blocks, regardless of stake (default: 336 = 14d)
MONITOR_CAP_HOURS=336
# Pools expected to produce fewer than this many blocks/epoch get NO block alerts
# (retired / ~0-stake pools are statistically un-monitorable). Default: 1.0
MONITOR_MIN_BLOCKS_EPOCH=1.0

# --- Optional: KES alert tiers (days before estimated expiry) ---
MONITOR_KES_THRESHOLDS=14,7,2

# --- Optional: Apex Fusion Prime network constants ---
# Defaults are the VERIFIED on-chain genesis values. Do NOT trust the Blockfrost
# /genesis endpoint, which returns Cardano-mainnet values (62, etc.) on Prime.
# Override only after a Prime hard-fork that changes these.
PRIME_MAX_KES_EVOLUTIONS=60
PRIME_SLOTS_PER_KES_PERIOD=129600
PRIME_SLOT_LENGTH=1
PRIME_EPOCH_LENGTH=432000
PRIME_ACTIVE_SLOTS_COEFF=0.05
